# syntax=docker/dockerfile:1.7
# The h5i-pay API (ECS Fargate). Build from the repository root:
#   docker build -f infra/docker/Dockerfile.api -t h5i-pay/api .
FROM rust:1.99-bookworm AS build
WORKDIR /src
COPY . .
# Empty (the default) for the production image: no Mock PSP in the binary,
# so H5I_PAY_PSP=mock is refused at startup (SEC-05). The synthetic-funds
# test image is built with --build-arg API_FEATURES=mock-psp and tagged
# <sha>-mock.
ARG API_FEATURES=""
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p payment-api --bin h5i-pay ${API_FEATURES:+--features "$API_FEATURES"} \
 && cp target/release/h5i-pay /h5i-pay

# No shell, no package manager; runs as uid 65532.
FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=build /h5i-pay /usr/local/bin/h5i-pay
# The Amazon RDS global CA bundle, vendored from
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# (refresh with infra/docker/update-rds-ca.sh). The ECS task sets DB_CA_FILE
# to this path; when it is unset (local compose) the API uses plain TCP.
COPY infra/docker/rds-global-bundle.pem /etc/h5i-pay/rds-global-bundle.pem
USER 65532:65532
ENV LISTEN=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/h5i-pay"]
