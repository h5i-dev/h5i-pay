  have e : Transfer.from_rows_loop rows (alloc.vec.Vec.new Transfer) true 0#usize =
      loop (fun x => rowsBody Transfer.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Transfer, true, 0#usize) := by
    unfold Transfer.from_rows_loop; congr 1; funext ⟨a, b, c⟩
