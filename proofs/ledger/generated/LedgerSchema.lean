    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Transfer.from_rows_loop rows (alloc.vec.Vec.new Transfer) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Transfer.from_row Transfer.row (fun x v hv => Transfer.from_row_spec x v hv) rows l h
  unfold Transfer.from_rows
  step with hl
  simp [ok1_post, l_post]

theorem Ledger.from_one_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Ledger)
    (hl : l.length ≤ 1) (h : rows.val.map (·.val) = l.map Ledger.row) :
    Ledger.from_one rows ⦃ o => o = some (l.headD Ledger.zero) ⦄ := by
  unfold Ledger.from_one
  match l, hl with
  | [], _ =>
    have hr : rows.val = [] := by simpa using h
    have h0 : rows.len = 0#usize := by scalar_tac
    rw [if_pos h0]; step*; simp_all [Ledger.zero]
  | [x], _ =>
    obtain ⟨v, hv, hvv⟩ : ∃ v, rows.val = [v] ∧ v.val = Ledger.row x := by
      simp only [List.map_cons, List.map_nil] at h
      obtain ⟨v, rest⟩ := List.map_eq_singleton_iff.1 h
      exact ⟨v, rest.1, rest.2⟩
    have h0 : ¬ rows.len = 0#usize := by scalar_tac
    have h1 : rows.len = 1#usize := by scalar_tac
    rw [if_neg h0, if_pos h1]
    step as ⟨ w, hw ⟩
    have : w.val = Ledger.row x := by rw [hw]; simp [hv, hvv]
    step with Ledger.from_row_spec x w this
    simp_all

