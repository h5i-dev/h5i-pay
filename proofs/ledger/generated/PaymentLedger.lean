    ok (some out)
  | Command.Transfer t =>
    let p ← accounts_of t
    let r ← rd_where T_ACCOUNTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let v ← v_int t.id
    let p1 ← p_eq TRANSFER_ID v
    let r1 ← rd_where T_TRANSFERS p1
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)
