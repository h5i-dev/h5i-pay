/-- [payment_ledger::decode]:
    Source: '/cargo/git/checkouts/h5i-65ea82406b9a50c7/a98bcbd/crates/h5i-app-schema/src/lib.rs', lines 289:8-297:9
    Visibility: public -/
def decode (r : Rows) : Result (Option Snapshot) := do
  let o ← Ledger.from_one r.ledger
  match o with
  | none => ok none
  | some x =>
    let o1 ← Account.from_rows r.accounts
    match o1 with
    | none => ok none
    | some x1 =>
      let o2 ← Transfer.from_rows r.transfers
      match o2 with
      | none => ok none
      | some x2 =>
        let o3 ← OwnerCounter.from_rows r.owners
        match o3 with
        | none => ok none
        | some x3 =>
          let o4 ← HistoryEntry.from_rows r.history
          match o4 with
          | none => ok none
          | some x4 =>
            ok (some
              {
                ledger := x,
                accounts := x1,
                transfers := x2,
                owners := x3,
                history := x4
              })

