import Ledger.Commands
import LedgerSchema
/-!
# What a read plan loads

`reads a c` (extracted from `payment_ledger::reads`) names one declarative
read per table; `LedgerStore::load_for` loads each table by its read
(`schema_load_plan`) and `decode`s, or loads the whole tenant when `reads`
says `None`. Here the extracted reads are read as `H5iAppLib.Query` reads
(`Read.abs`, `readsA`, `reads_abs`). What loading a plan decodes to,
`Snapshot.load plan s`, and its `decode_load` are generated by `schema!`
(`generated/LedgerSchema.lean`). `Ledger/Frame.lean` shows `transition`
gives the same result on `Snapshot.load plan s` as on `s`.

Tables and columns are numbered as in `schema!`: accounts 0 (id, owner, ...),
transfers 1 (id, ...), the ledger counter 2.

Trusted: PostgreSQL returns, for each read, `Read.rows` of the tenant's
tables listed in key order, which h5i's differential tests of
`h5i_app_pgsql::compile_read` check.
-/
open Aeneas Aeneas.Std Result payment_ledger payment_ledger.Schema H5iAppLib

namespace payment_ledger.Plan

open H5iAppLib.Query

def Window.abs (w : h5i_app_sql.Window) : Window := ⟨w.desc, w.offset.val, w.limit.map (·.val)⟩

def Pred.abs : h5i_app_sql.Pred → Pred Val
  | .All => .all
  | .Eq c v => .eq c.val v
  | .In c t p o w => .isIn c.val t.val (Pred.abs p) o.val (Window.abs w)
  | .And p q => .and (Pred.abs p) (Pred.abs q)
  | .Or p q => .or (Pred.abs p) (Pred.abs q)

def Read.abs (r : h5i_app_sql.Read) : Read Val := ⟨r.table.val, Pred.abs r.pred, Window.abs r.window⟩

/-- The plan of `reads a c`, if any, as `H5iAppLib.Query` reads. -/
def planOf (o : Option (alloc.vec.Vec h5i_app_sql.Read)) : Option (List (Read Val)) :=
  o.map (fun v => v.val.map Read.abs)

/-! ## The plans, written out -/

def eqU (c : Nat) (u : U64) : Pred Val := .eq c (int u.val)

/-- The two accounts of a transfer. -/
def accsA (t : TransferReq) : Pred Val := .or (eqU 0 t.debit) (eqU 0 t.credit)

def accsStep (p : Pred Val) (t : TransferReq) : Pred Val := .or p (accsA t)
def idsStep (p : Pred Val) (t : TransferReq) : Pred Val := .or p (eqU 0 t.id)

/-- A non-empty batch `t0 :: rest`: its accounts and its transfer ids. -/
def batchA (t0 : TransferReq) (rest : List TransferReq) : List (Read Val) :=
  [⟨0, rest.foldl accsStep (accsA t0), {}⟩, ⟨1, rest.foldl idsStep (eqU 0 t0.id), {}⟩]

def readsA (a : Principal) : Command → Option (List (Read Val))
  | .Open .. => some [⟨2, .all, {}⟩]
  | .Transfer t => some [⟨0, accsA t, {}⟩, ⟨1, eqU 0 t.id, {}⟩]
  | .Batch ts =>
    match ts.val with
    | [] => some []
    | t0 :: rest => if ts.val.length > 64 then none else some (batchA t0 rest)
  | .Account id => some [⟨0, eqU 0 id, {}⟩]
  | .Accounts => if a.operator then some [⟨0, .all, {}⟩] else some [⟨0, eqU 1 a.user, {}⟩]
  | .Transfers => if a.operator then some [⟨1, .all, {}⟩] else some []

/-! ## The extracted plans compute `readsA` -/

/-- The extracted predicates the batch loop builds, before abstraction. -/
def accsP (t : TransferReq) : h5i_app_sql.Pred := .Or (.Eq 0#u32 (int t.debit.val)) (.Eq 0#u32 (int t.credit.val))

def stepP (pq : h5i_app_sql.Pred × h5i_app_sql.Pred) (t : TransferReq) : h5i_app_sql.Pred × h5i_app_sql.Pred :=
  (.Or pq.1 (accsP t), .Or pq.2 (.Eq 0#u32 (int t.id.val)))

@[simp] theorem v_int_eq (x : U64) : v_int x = ok (int x.val) := by
  simp [v_int, u64_to_val_eq]

theorem accounts_of_eq (t : TransferReq) : accounts_of t = ok (accsP t) := by
  simp [accounts_of, p_eq, p_or, accsP, ACCOUNT_ID]

theorem vec_index_eq {α : Type} (v : alloc.vec.Vec α) (i : Usize) (h : i.val < v.val.length) :
    alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice α) v i = ok v.val[i.val] := by
  rw [alloc.vec.Vec.index_slice_index]; unfold alloc.vec.Vec.index_usize
  simp [h]

theorem batch_reads_loop_spec (ts : alloc.vec.Vec TransferReq) (p q : h5i_app_sql.Pred) (i : Usize)
    (hi : i.val ≤ ts.length) :
    batch_reads_loop ts p q i ⦃ r => r = (ts.val.drop i.val).foldl stepP (p, q) ⦄ := by
  unfold batch_reads_loop
  have h := loop_fold2 ts.val (fun a b => (a, b)) stepP (fun _ _ _ => True)
    (fun x => batch_reads_loop.body ts x.1 x.2.1 x.2.2) ?_ p q i (by simpa using hi) trivial
  · exact WP.spec_mono h (fun r hr => by obtain ⟨r1, r2⟩ := r; simpa using hr.1)
  · intro a b j hj _
    unfold batch_reads_loop.body
    simp only [alloc.vec.Vec.len]
    split
    · rename_i hlt
      have hlt' : j.val < ts.val.length := by scalar_tac
      rw [vec_index_eq ts j hlt']
      simp only [bind_ok, accounts_of_eq, p_or, v_int_eq, p_eq]
      have : j.val + 1 ≤ Usize.max := by simp only [alloc.vec.Vec.length] at *; scalar_tac
      step*
      simp only [FoldStep2]
      exact ⟨hlt', by simp [stepP, TRANSFER_ID], by scalar_tac, trivial⟩
    · rename_i hge
      simp only [WP.spec_ok, FoldStep2, and_true]
      simp only [alloc.vec.Vec.length] at *; scalar_tac

theorem abs_foldl (l : List TransferReq) (p q : h5i_app_sql.Pred) :
    Pred.abs (l.foldl stepP (p, q)).1 = l.foldl accsStep (Pred.abs p) ∧
      Pred.abs (l.foldl stepP (p, q)).2 = l.foldl idsStep (Pred.abs q) := by
  induction l generalizing p q with
  | nil => simp
  | cons t l ih =>
    simp only [List.foldl_cons, stepP]
    obtain ⟨h1, h2⟩ := ih (.Or p (accsP t)) (.Or q (.Eq 0#u32 (int t.id.val)))
    refine ⟨h1.trans ?_, h2.trans ?_⟩ <;> rfl

theorem batch_reads_abs (ts : alloc.vec.Vec TransferReq) (t0 : TransferReq) (rest : List TransferReq)
    (h : ts.val = t0 :: rest) :
    ∃ v, batch_reads ts = ok v ∧ v.val.map Read.abs = batchA t0 rest := by
  have h0 : (0#usize).val < ts.val.length := by simp [h]
  have hl : (1#usize).val ≤ ts.length := by simp [alloc.vec.Vec.length, h]
  obtain ⟨r, hr⟩ := ok_of (batch_reads_loop_spec ts (accsP t0) (.Eq 0#u32 (int t0.id.val)) 1#usize hl)
  have hr' := post_of_ok (batch_reads_loop_spec ts (accsP t0) (.Eq 0#u32 (int t0.id.val)) 1#usize hl) hr
  unfold batch_reads
  rw [vec_index_eq _ 0#usize h0]
  have ht0 : ts.val[(0#usize).val]'h0 = t0 := by simp [h]
  rw [ht0]
  simp only [bind_ok, accounts_of_eq, v_int_eq, p_eq, TRANSFER_ID]
  rw [hr]
  obtain ⟨r1, r2⟩ := r
  have hdrop : ts.val.drop (1#usize).val = rest := by simp [h]
  rw [hdrop] at hr'
  obtain ⟨e1, e2⟩ := abs_foldl rest (accsP t0) (.Eq 0#u32 (int t0.id.val))
  rw [← hr'] at e1 e2
  simp only at e1 e2
  simp [rd_where, h5i_app_sql.whole, alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits,
    alloc.vec.Vec.from_val, batchA, Read.abs, e1, e2, Window.abs, T_ACCOUNTS, T_TRANSFERS, accsA, accsP, Pred.abs, eqU]

/-- The extracted `reads` computes `readsA`. -/
theorem reads_abs (a : Principal) (c : Command) : ∃ o, reads a c = ok o ∧ planOf o = readsA a c := by
  cases c
  case Batch ts =>
    have hlenv : (alloc.vec.Vec.len ts).val = ts.val.length := by simp [alloc.vec.Vec.len]
    cases hv : ts.val with
    | nil =>
      have h0 : alloc.vec.Vec.len ts = 0#usize := by apply UScalar.eq_of_val_eq; rw [hlenv, hv]; rfl
      simp only [reads, readsA, hv, h0, if_true]
      exact ⟨_, rfl, rfl⟩
    | cons t0 rest =>
      have hne : ¬ (alloc.vec.Vec.len ts = 0#usize) := by
        intro h0; have := congrArg UScalar.val h0; rw [hlenv, hv] at this; simp at this
      by_cases hgt : alloc.vec.Vec.len ts > MAX_PLANNED_BATCH
      · have : (t0 :: rest).length > 64 := by
          rw [← hv, ← hlenv]; simp only [MAX_PLANNED_BATCH] at hgt; scalar_tac
        have h64 : 64 ≤ rest.length := by simp at this; omega
        simp [reads, readsA, hv, hne, hgt, h64, planOf, MAX_PLANNED_BATCH]
      · have : ¬ (t0 :: rest).length > 64 := by
          rw [← hv, ← hlenv]; simp only [MAX_PLANNED_BATCH] at hgt; scalar_tac
        obtain ⟨v, hb, hvb⟩ := batch_reads_abs ts t0 rest hv
        simp only [reads, readsA, hv, hne, hgt, this, if_false, hb, bind_ok]
        exact ⟨_, rfl, by simp [planOf, hvb]⟩
  case Accounts =>
    cases ha : a.operator <;>
      simp [reads, readsA, ha, rd_where, p_eq, h5i_app_sql.whole, planOf, Read.abs, Pred.abs, Window.abs, eqU,
        alloc.vec.Vec.push, alloc.vec.Vec.new, T_ACCOUNTS, ACCOUNT_OWNER, U32.max, U32.numBits, alloc.vec.Vec.from_val]
  case Transfers =>
    cases ha : a.operator <;>
      simp [reads, readsA, ha, rd_where, h5i_app_sql.whole, planOf, Read.abs, Pred.abs, Window.abs,
        alloc.vec.Vec.push, alloc.vec.Vec.new, T_TRANSFERS, U32.max, U32.numBits, alloc.vec.Vec.from_val]
  all_goals simp [reads, readsA, rd_where, p_eq, accounts_of_eq, h5i_app_sql.whole, planOf, Read.abs, Pred.abs,
    Window.abs, eqU, accsA, accsP, alloc.vec.Vec.push, alloc.vec.Vec.new, T_ACCOUNTS, T_TRANSFERS, T_LEDGER,
    ACCOUNT_ID, TRANSFER_ID, U32.max, U32.numBits, alloc.vec.Vec.from_val]

end payment_ledger.Plan
