import Payments.Commands
import PaymentsSchema
/-!
# What a read plan loads

`reads a c` (extracted from `payment_domain::reads`) names one declarative
read per table; `PaymentsStore::load_for` loads each table by its read
(`schema_load_plan`) and `decode`s. Here the extracted reads are read as
`H5iAppLib.Query` reads (`Read.abs`, `readsA`, `reads_abs`). What loading a
plan decodes to, `Snapshot.load plan s`, and `decode_load` are generated by
`schema!` (`generated/PaymentsSchema.lean`). `Payments/Frame.lean` shows
`transition` gives the same result on `Snapshot.load plan s` as on `s`.

Tables and columns are numbered as in `schema!`: payments 0 (id, merchant,
...), refunds 1 (id, payment, ...), PSP events 2 (id, payment), PSP
references 3 (payment, reference), the counter 4.

Trusted: PostgreSQL returns, for each read, `Read.rows` of the tenant's
tables listed in key order, which h5i's differential tests of
`h5i_app_pgsql::compile_read` check.
-/
open Aeneas Aeneas.Std Result payment_domain payment_domain.Schema H5iAppLib

namespace payment_domain.Plan

open H5iAppLib.Query

def Window.abs (w : h5i_app_sql.Window) : Window := ⟨w.desc, w.offset.val, w.limit.map (·.val)⟩

def Pred.abs : h5i_app_sql.Pred → Pred Val
  | .All => .all
  | .Eq c v => .eq c.val v
  | .Ge c v => .ge c.val v
  | .Lt c v => .lt c.val v
  | .In c t p o w => .isIn c.val t.val (Pred.abs p) o.val (Window.abs w)
  | .And p q => .and (Pred.abs p) (Pred.abs q)
  | .Or p q => .or (Pred.abs p) (Pred.abs q)

def Read.abs (r : h5i_app_sql.Read) : Read Val := ⟨r.table.val, Pred.abs r.pred, Window.abs r.window⟩

/-- The plan of `reads a c`, if any, as `H5iAppLib.Query` reads. -/
def planOf (o : Option (alloc.vec.Vec h5i_app_sql.Read)) : Option (List (Read Val)) :=
  o.map (fun v => v.val.map Read.abs)

/-! ## The plans, written out -/

def eqU (c : Nat) (u : U64) : Pred Val := .eq c (int u.val)

/-- The refund a refund result names. -/
def resultA : PspResult → List (Read Val)
  | .RefundSucceeded r => [⟨1, eqU 0 r, {}⟩]
  | .RefundFailed r => [⟨1, eqU 0 r, {}⟩]
  | _ => []

/-- `page_end` in numbers: `f + l`, or `U64.max` if that overflows. -/
def pageEndN (f l : Nat) : Nat := if f > U64.max - l then U64.max else f + l

/-- Where `BIGINT` order wraps the `u64` ids: `int` keeps a `u64`'s bits,
so ids from 2^63 up are negative. -/
abbrev signN : Nat := 2 ^ 63

/-- Column `c` holds one of `f`, …, `x - 1` (`seq_range`, H2): `c ≥ f` and
`c < x` as `BIGINT`s, or, for a range that crosses 2^63, `c ≥ f` or `c < x`. -/
def rangeA (c f x : Nat) : Pred Val :=
  if f < signN ∧ signN ≤ x then .or (.ge c (int f)) (.lt c (int x)) else .and (.ge c (int f)) (.lt c (int x))

/-- A `List` page that is not refused: `merchant`'s payments numbered
`from` to `end - 1`, and the merchant's counter. -/
def pageA (m : U64) (f e : Nat) : List (Read Val) :=
  if f < e then [⟨0, .and (eqU 1 m) (rangeA 13 f e), {}⟩, ⟨5, eqU 0 m, {}⟩] else [⟨5, eqU 0 m, {}⟩]

/-- A `History` page that is not refused: the payment, and its entries
numbered `from` to `end - 1`. -/
def histA (p : U64) (f e : Nat) : List (Read Val) :=
  if f < e then [⟨0, eqU 0 p, {}⟩, ⟨6, .and (eqU 0 p) (rangeA 1 f e), {}⟩] else [⟨0, eqU 0 p, {}⟩]

/-- A `Range` page that is not refused (G6): the payments with ids `from`
to `end - 1` and the payments of the refunds with those ids, those
refunds, and the counter. -/
def rangePageA (f e : Nat) : List (Read Val) :=
  if f < e then [⟨0, rangeA 0 f e, {}⟩, ⟨4, .all, {}⟩] else [⟨4, .all, {}⟩]

/-- A `RefundRange` page that is not refused (G6): the refunds with ids
`from` to `end - 1`, their payments, and the counter. -/
def refundPageA (f e : Nat) : List (Read Val) :=
  if f < e then [⟨1, rangeA 0 f e, {}⟩, ⟨0, .isIn 0 1 (rangeA 0 f e) 1 {}, {}⟩, ⟨4, .all, {}⟩] else [⟨4, .all, {}⟩]

def readsA (a : Principal) : Command → Option (List (Read Val))
  | .Create .. => some [⟨4, .all, {}⟩, ⟨5, eqU 0 a.user, {}⟩]
  | .BeginAuthorize id => some [⟨0, eqU 0 id, {}⟩]
  | .Cancel id => some [⟨0, eqU 0 id, {}⟩]
  | .RequestRefund p _ => some [⟨0, eqU 0 p, {}⟩, ⟨4, .all, {}⟩]
  | .Record p r => some (⟨0, eqU 0 p, {}⟩ :: resultA r)
  | .Event e p r => some (⟨2, eqU 0 e, {}⟩ :: ⟨0, eqU 0 p, {}⟩ :: resultA r)
  | .AttachRef p _ => some [⟨0, eqU 0 p, {}⟩, ⟨3, eqU 0 p, {}⟩]
  | .Get id => some [⟨0, eqU 0 id, {}⟩]
  | .List m f l =>
    if l.val ≠ 0 ∧ l.val ≤ 64 ∧ (a.operator = true ∨ m = a.user) then some (pageA m f.val (pageEndN f.val l.val))
    else some []
  | .GetRefund id => some [⟨1, eqU 0 id, {}⟩, ⟨0, .isIn 0 1 (eqU 0 id) 1 {}, {}⟩]
  | .Refunds p => some [⟨0, eqU 0 p, {}⟩, ⟨1, eqU 1 p, {}⟩]
  | .GetRef p => some [⟨0, eqU 0 p, {}⟩, ⟨3, eqU 0 p, {}⟩]
  | .View id => some [⟨0, eqU 0 id, {}⟩, ⟨1, eqU 1 id, {}⟩, ⟨3, eqU 0 id, {}⟩]
  | .MarkPosted p _ _ => some [⟨0, eqU 0 p, {}⟩, ⟨1, eqU 1 p, {}⟩]
  | .History p f l =>
    if l.val ≠ 0 ∧ l.val ≤ 64 ∧ a.operator = true then some (histA p f.val (pageEndN f.val l.val))
    else some []
  | .Range f l =>
    if l.val ≠ 0 ∧ l.val ≤ 4096 ∧ a.operator = true then some (rangePageA f.val (pageEndN f.val l.val))
    else some []
  | .RefundRange f l =>
    if l.val ≠ 0 ∧ l.val ≤ 4096 ∧ a.operator = true then some (refundPageA f.val (pageEndN f.val l.val))
    else some []

/-! ## The extracted plans compute `readsA` -/

@[simp] theorem v_int_eq (x : U64) : v_int x = ok (int x.val) := by
  simp [v_int, u64_to_val_eq]

theorem result_reads_abs (r : PspResult) (out : alloc.vec.Vec h5i_app_sql.Read) (h : out.length < 4) :
    ∃ v, result_reads r out = ok v ∧ v.val.map Read.abs = out.val.map Read.abs ++ resultA r := by
  have h' : out.val.length < 4294967295 := by simp only [alloc.vec.Vec.length] at h; omega
  cases r <;> simp [result_reads, resultA, rd_where, p_eq, h5i_app_sql.whole, alloc.vec.Vec.push, Read.abs,
    Pred.abs, Window.abs, eqU, T_REFUNDS, REFUND_ID, U32.max, U32.numBits, alloc.vec.Vec.from_val, h']

theorem result_reads_some (r : PspResult) (out : alloc.vec.Vec h5i_app_sql.Read) (h : out.length < 4) :
    ∃ o, (do let out1 ← result_reads r out; ok (some out1)) = ok o ∧
      planOf o = some (out.val.map Read.abs ++ resultA r) := by
  obtain ⟨v, hv, hva⟩ := result_reads_abs r out h
  exact ⟨some v, by rw [hv]; simp, by simp [planOf, hva]⟩

theorem ok_of' {α} {m : Result α} {P : α → Prop} (h : m ⦃ P ⦄) : ∃ r, m = ok r ∧ P r := by
  obtain ⟨r, hr⟩ := ok_of h; exact ⟨r, hr, post_of_ok h hr⟩

theorem page_end_spec (f : U64) (l : U32) : page_end f l ⦃ e => e.val = pageEndN f.val l.val ⦄ := by
  unfold page_end pageEndN
  step*
  all_goals simp_all [core.num.U64.MAX, U64.rMax] <;> scalar_tac

theorem seq_range_spec (col : U32) (f e : U64) (h : f.val < e.val) :
    seq_range col f e ⦃ r => Pred.abs r = rangeA col.val f.val e.val ⦄ := by
  unfold seq_range rangeA
  simp only [v_int_eq, p_or, bind_ok]
  have hs : SIGN.val = signN := by simp [SIGN, signN]
  split
  · rename_i h1
    split
    · rename_i h2
      have : f.val < signN ∧ signN ≤ e.val := ⟨by scalar_tac, by scalar_tac⟩
      simp [Pred.abs, this]
    · rename_i h2
      have : ¬ (f.val < signN ∧ signN ≤ e.val) := by scalar_tac
      simp [Pred.abs, this]
  · rename_i h1
    have : ¬ (f.val < signN ∧ signN ≤ e.val) := by scalar_tac
    simp [Pred.abs, this]

/-- The extracted `reads` computes `readsA`. -/
theorem reads_abs (a : Principal) (c : Command) : ∃ o, reads a c = ok o ∧ planOf o = readsA a c := by
  cases c
  case Record p r =>
    simp only [reads, v_int_eq, p_eq, rd_where, h5i_app_sql.whole, bind_ok]
    simp only [alloc.vec.Vec.push, alloc.vec.Vec.new, List.length_nil, U32.max, U32.numBits]
    rw [dif_pos (by simp)]; simp only [bind_ok]
    refine Exists.elim (result_reads_some r _ ?_) (fun o h => ⟨o, h.1, h.2.trans ?_⟩)
    · simp [alloc.vec.Vec.length]
    · simp [readsA, Read.abs, Pred.abs, Window.abs, eqU, T_PAYMENTS, PAYMENT_ID]
  case Event e p r =>
    simp only [reads, v_int_eq, p_eq, rd_where, h5i_app_sql.whole, bind_ok]
    simp only [alloc.vec.Vec.push, alloc.vec.Vec.new, List.length_nil, U32.max, U32.numBits]
    rw [dif_pos (by simp)]; simp only [bind_ok]
    simp only [alloc.vec.Vec.from_val, List.nil_append, List.length_singleton]
    rw [dif_pos (by simp)]; simp only [bind_ok]
    refine Exists.elim (result_reads_some r _ ?_) (fun o h => ⟨o, h.1, h.2.trans ?_⟩)
    · simp [alloc.vec.Vec.length]
    · simp [readsA, Read.abs, Pred.abs, Window.abs, eqU, T_PAYMENTS, PAYMENT_ID, T_EVENTS, EVENT_ID]
  case List m f l =>
    obtain ⟨e, he, hev⟩ := ok_of' (page_end_spec f l)
    have page : ∃ o, (do
        let out ← if f < e then do
            let range ← seq_range PAYMENT_SEQ f e
            let v ← v_int m
            let p ← p_eq PAYMENT_MERCHANT v
            let r ← rd_where T_PAYMENTS (h5i_app_sql.Pred.And p range)
            alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
          else ok (alloc.vec.Vec.new h5i_app_sql.Read)
        let v ← v_int m
        let p ← p_eq MERCHANT_KEY v
        let r ← rd_where T_MERCHANTS p
        let out1 ← alloc.vec.Vec.push out r
        ok (some out1)) = ok o ∧ planOf o = some (pageA m f.val (pageEndN f.val l.val)) := by
      rw [← hev]
      by_cases hfe : f < e
      · obtain ⟨r, hr, hra⟩ := ok_of' (seq_range_spec PAYMENT_SEQ f e (by scalar_tac))
        simp only [hfe, if_true, hr, bind_ok, v_int_eq, p_eq, rd_where, h5i_app_sql.whole]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, pageA,
          Read.abs, Pred.abs, Window.abs, eqU, hra, T_PAYMENTS, T_MERCHANTS, PAYMENT_MERCHANT, PAYMENT_SEQ, MERCHANT_KEY,
          show f.val < e.val by scalar_tac]
      · simp only [hfe, if_false, bind_ok, v_int_eq, p_eq, rd_where, h5i_app_sql.whole]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, pageA,
          Read.abs, Pred.abs, Window.abs, eqU, T_MERCHANTS, MERCHANT_KEY, show ¬ f.val < e.val by scalar_tac]
    simp only [reads, readsA, he, bind_ok]
    by_cases h0 : l = 0#u32
    · subst h0; simp [planOf]
    have h0' : l.val ≠ 0 := fun h => h0 (by scalar_tac)
    by_cases hm : l ≤ MAX_PAGE
    · have hm' : l.val ≤ 64 := by simp only [MAX_PAGE] at hm; scalar_tac
      cases ha : a.operator
      · by_cases hu : m = a.user
        · simp only [h0, hm, hu, ha, h0', hm', bne_iff_ne, ne_eq, not_false_eq_true, if_true,
            is_operator_eq, user_of_eq, bind_ok, Bool.false_eq_true, if_false, true_and, or_true, and_self]
          rw [← hu]; exact page
        · simp [h0, hm, hu, ha, h0', hm', planOf]
      · simp only [h0, hm, ha, h0', hm', bne_iff_ne, ne_eq, not_false_eq_true, if_true, is_operator_eq, bind_ok,
          true_and, true_or, and_self]
        exact page
    · have hm' : ¬ l.val ≤ 64 := by simp only [MAX_PAGE] at hm; scalar_tac
      simp [h0, hm, hm', planOf]
  case History p f l =>
    obtain ⟨e, he, hev⟩ := ok_of' (page_end_spec f l)
    have page : ∃ o, (do
        let v ← v_int p
        let q ← p_eq PAYMENT_ID v
        let r ← rd_where T_PAYMENTS q
        let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
        let «end» ← page_end f l
        if f < «end» then do
            let range ← seq_range HISTORY_N f «end»
            let q1 ← p_eq HISTORY_PAYMENT v
            let r1 ← rd_where T_HISTORY (h5i_app_sql.Pred.And q1 range)
            let out1 ← alloc.vec.Vec.push out r1
            ok (some out1)
          else ok (some out)) = ok o ∧ planOf o = some (histA p f.val (pageEndN f.val l.val)) := by
      rw [← hev]
      simp only [v_int_eq, p_eq, rd_where, h5i_app_sql.whole, bind_ok, he]
      by_cases hfe : f < e
      · obtain ⟨r, hr, hra⟩ := ok_of' (seq_range_spec HISTORY_N f e (by scalar_tac))
        simp only [hfe, if_true, hr, bind_ok, v_int_eq, p_eq, rd_where, h5i_app_sql.whole]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, histA,
          Read.abs, Pred.abs, Window.abs, eqU, hra, T_PAYMENTS, T_HISTORY, PAYMENT_ID, HISTORY_PAYMENT, HISTORY_N,
          show f.val < e.val by scalar_tac]
      · simp only [hfe, if_false, bind_ok]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, histA,
          Read.abs, Pred.abs, Window.abs, eqU, T_PAYMENTS, PAYMENT_ID, show ¬ f.val < e.val by scalar_tac]
    simp only [reads, readsA]
    by_cases h0 : l = 0#u32
    · subst h0; simp [planOf]
    have h0' : l.val ≠ 0 := fun h => h0 (by scalar_tac)
    by_cases hm : l ≤ MAX_PAGE
    · have hm' : l.val ≤ 64 := by simp only [MAX_PAGE] at hm; scalar_tac
      cases ha : a.operator
      · simp [h0, hm, ha, h0', hm', planOf]
      · simp only [h0, hm, ha, h0', hm', bne_iff_ne, ne_eq, not_false_eq_true, if_true, is_operator_eq, bind_ok,
          true_and, and_self, Bool.and_true, decide_true, Bool.true_and, and_true]
        exact page
    · have hm' : ¬ l.val ≤ 64 := by simp only [MAX_PAGE] at hm; scalar_tac
      simp [h0, hm, hm', planOf]
  case Range f l =>
    obtain ⟨e, he, hev⟩ := ok_of' (page_end_spec f l)
    have page : ∃ o, (do
        let «end» ← page_end f l
        let out ← if f < «end» then do
            let p ← seq_range PAYMENT_ID f «end»
            let r ← rd_where T_PAYMENTS p
            alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
          else ok (alloc.vec.Vec.new h5i_app_sql.Read)
        let r ← rd_where T_COUNTER h5i_app_sql.Pred.All
        let out1 ← alloc.vec.Vec.push out r
        ok (some out1)) = ok o ∧ planOf o = some (rangePageA f.val (pageEndN f.val l.val)) := by
      rw [← hev]
      simp only [he, bind_ok]
      by_cases hfe : f < e
      · obtain ⟨q, hq, hqa⟩ := ok_of' (seq_range_spec PAYMENT_ID f e (by scalar_tac))
        simp only [hfe, if_true, hq, bind_ok, rd_where, h5i_app_sql.whole]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, rangePageA,
          Read.abs, Pred.abs, Window.abs, hqa, T_PAYMENTS, T_COUNTER, PAYMENT_ID, show f.val < e.val by scalar_tac]
      · simp only [hfe, if_false, bind_ok, rd_where, h5i_app_sql.whole]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, rangePageA,
          Read.abs, Pred.abs, Window.abs, T_COUNTER, show ¬ f.val < e.val by scalar_tac]
    simp only [reads, readsA]
    by_cases h0 : l = 0#u32
    · subst h0; simp [planOf]
    have h0' : l.val ≠ 0 := fun h => h0 (by scalar_tac)
    by_cases hm : l ≤ MAX_RANGE
    · have hm' : l.val ≤ 4096 := by simp only [MAX_RANGE] at hm; scalar_tac
      cases ha : a.operator
      · simp [h0, hm, ha, h0', hm', planOf]
      · simp only [h0, hm, ha, h0', hm', bne_iff_ne, ne_eq, not_false_eq_true, if_true, is_operator_eq, bind_ok,
          true_and, and_self, Bool.and_true, decide_true, Bool.true_and, and_true]
        exact page
    · have hm' : ¬ l.val ≤ 4096 := by simp only [MAX_RANGE] at hm; scalar_tac
      simp [h0, hm, hm', planOf]
  case RefundRange f l =>
    obtain ⟨e, he, hev⟩ := ok_of' (page_end_spec f l)
    have page : ∃ o, (do
        let «end» ← page_end f l
        let out ← if f < «end» then do
            let p ← seq_range REFUND_ID f «end»
            let r ← rd_where T_REFUNDS p
            let out1 ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
            let w ← h5i_app_sql.whole
            let r1 ← rd_where T_PAYMENTS (h5i_app_sql.Pred.In PAYMENT_ID T_REFUNDS p REFUND_PAYMENT w)
            alloc.vec.Vec.push out1 r1
          else ok (alloc.vec.Vec.new h5i_app_sql.Read)
        let r ← rd_where T_COUNTER h5i_app_sql.Pred.All
        let out1 ← alloc.vec.Vec.push out r
        ok (some out1)) = ok o ∧ planOf o = some (refundPageA f.val (pageEndN f.val l.val)) := by
      rw [← hev]
      simp only [he, bind_ok]
      by_cases hfe : f < e
      · obtain ⟨q, hq, hqa⟩ := ok_of' (seq_range_spec REFUND_ID f e (by scalar_tac))
        simp only [hfe, if_true, hq, bind_ok, rd_where, h5i_app_sql.whole]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, refundPageA,
          Read.abs, Pred.abs, Window.abs, hqa, T_PAYMENTS, T_REFUNDS, T_COUNTER, PAYMENT_ID, REFUND_ID, REFUND_PAYMENT,
          show f.val < e.val by scalar_tac]
      · simp only [hfe, if_false, bind_ok, rd_where, h5i_app_sql.whole]
        simp [alloc.vec.Vec.push, alloc.vec.Vec.new, U32.max, U32.numBits, alloc.vec.Vec.from_val, planOf, refundPageA,
          Read.abs, Pred.abs, Window.abs, T_COUNTER, show ¬ f.val < e.val by scalar_tac]
    simp only [reads, readsA]
    by_cases h0 : l = 0#u32
    · subst h0; simp [planOf]
    have h0' : l.val ≠ 0 := fun h => h0 (by scalar_tac)
    by_cases hm : l ≤ MAX_RANGE
    · have hm' : l.val ≤ 4096 := by simp only [MAX_RANGE] at hm; scalar_tac
      cases ha : a.operator
      · simp [h0, hm, ha, h0', hm', planOf]
      · simp only [h0, hm, ha, h0', hm', bne_iff_ne, ne_eq, not_false_eq_true, if_true, is_operator_eq, bind_ok,
          true_and, and_self, Bool.and_true, decide_true, Bool.true_and, and_true]
        exact page
    · have hm' : ¬ l.val ≤ 4096 := by simp only [MAX_RANGE] at hm; scalar_tac
      simp [h0, hm, hm', planOf]
  all_goals simp [reads, readsA, rd_where, p_eq, h5i_app_sql.whole, planOf, Read.abs, Pred.abs,
    Window.abs, eqU, alloc.vec.Vec.push, alloc.vec.Vec.new, T_PAYMENTS, T_REFUNDS, T_REFS, T_COUNTER,
    T_MERCHANTS, MERCHANT_KEY, user_of_eq,
    PAYMENT_ID, REFUND_ID, REFUND_PAYMENT, REF_PAYMENT, U32.max, U32.numBits, alloc.vec.Vec.from_val]

end payment_domain.Plan
