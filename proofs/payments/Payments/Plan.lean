import Payments.Commands
import PaymentsSchema
/-!
# What a read plan loads

`reads a c` (extracted from `payment_domain::reads`) names one declarative
read per table; `PaymentsStore::load_for` loads each table by its read
(`schema_load_plan`) and `decode`s. Here the extracted reads are read as
`H5iAppLib.Query` reads (`Read.abs`, `readsA`, `reads_abs`). What loading a
plan decodes to, `Snapshot.load plan s`, and `decode_load` are generated by
`schema!` (`generated/PaymentsSchema.lean`). `Payments/Frame.lean` shows
`transition` gives the same result on `Snapshot.load plan s` as on `s`.

Tables and columns are numbered as in `schema!`: payments 0 (id, merchant,
...), refunds 1 (id, payment, ...), PSP events 2 (id, payment), PSP
references 3 (payment, reference), the counter 4.

Trusted: PostgreSQL returns, for each read, `Read.rows` of the tenant's
tables listed in key order, which h5i's differential tests of
`h5i_app_pgsql::compile_read` check.
-/
open Aeneas Aeneas.Std Result payment_domain payment_domain.Schema H5iAppLib

namespace payment_domain.Plan

open H5iAppLib.Query

def Window.abs (w : h5i_app_sql.Window) : Window := ⟨w.desc, w.offset.val, w.limit.map (·.val)⟩

def Pred.abs : h5i_app_sql.Pred → Pred Val
  | .All => .all
  | .Eq c v => .eq c.val v
  | .In c t p o w => .isIn c.val t.val (Pred.abs p) o.val (Window.abs w)
  | .And p q => .and (Pred.abs p) (Pred.abs q)
  | .Or p q => .or (Pred.abs p) (Pred.abs q)

def Read.abs (r : h5i_app_sql.Read) : Read Val := ⟨r.table.val, Pred.abs r.pred, Window.abs r.window⟩

/-- The plan of `reads a c`, if any, as `H5iAppLib.Query` reads. -/
def planOf (o : Option (alloc.vec.Vec h5i_app_sql.Read)) : Option (List (Read Val)) :=
  o.map (fun v => v.val.map Read.abs)

/-! ## The plans, written out -/

def eqU (c : Nat) (u : U64) : Pred Val := .eq c (int u.val)

/-- The refund a refund result names. -/
def resultA : PspResult → List (Read Val)
  | .RefundSucceeded r => [⟨1, eqU 0 r, {}⟩]
  | .RefundFailed r => [⟨1, eqU 0 r, {}⟩]
  | _ => []

def readsA (a : Principal) : Command → Option (List (Read Val))
  | .Create .. => some [⟨4, .all, {}⟩]
  | .BeginAuthorize id => some [⟨0, eqU 0 id, {}⟩]
  | .Cancel id => some [⟨0, eqU 0 id, {}⟩]
  | .RequestRefund p _ => some [⟨0, eqU 0 p, {}⟩, ⟨4, .all, {}⟩]
  | .Record p r => some (⟨0, eqU 0 p, {}⟩ :: resultA r)
  | .Event e p r => some (⟨2, eqU 0 e, {}⟩ :: ⟨0, eqU 0 p, {}⟩ :: resultA r)
  | .AttachRef p _ => some [⟨0, eqU 0 p, {}⟩, ⟨3, eqU 0 p, {}⟩]
  | .Get id => some [⟨0, eqU 0 id, {}⟩]
  | .List => if a.operator then some [⟨0, .all, {}⟩] else some [⟨0, eqU 1 a.user, {}⟩]
  | .GetRefund id => some [⟨1, eqU 0 id, {}⟩, ⟨0, .isIn 0 1 (eqU 0 id) 1 {}, {}⟩]
  | .Refunds p => some [⟨0, eqU 0 p, {}⟩, ⟨1, eqU 1 p, {}⟩]
  | .GetRef p => some [⟨0, eqU 0 p, {}⟩, ⟨3, eqU 0 p, {}⟩]
  | .View id => some [⟨0, eqU 0 id, {}⟩, ⟨1, eqU 1 id, {}⟩, ⟨3, eqU 0 id, {}⟩]

/-! ## The extracted plans compute `readsA` -/

@[simp] theorem v_int_eq (x : U64) : v_int x = ok (int x.val) := by
  simp [v_int, u64_to_val_eq]

theorem result_reads_abs (r : PspResult) (out : alloc.vec.Vec h5i_app_sql.Read) (h : out.length < 4) :
    ∃ v, result_reads r out = ok v ∧ v.val.map Read.abs = out.val.map Read.abs ++ resultA r := by
  have h' : out.val.length < 4294967295 := by simp only [alloc.vec.Vec.length] at h; omega
  cases r <;> simp [result_reads, resultA, rd_where, p_eq, h5i_app_sql.whole, alloc.vec.Vec.push, Read.abs,
    Pred.abs, Window.abs, eqU, T_REFUNDS, REFUND_ID, U32.max, U32.numBits, alloc.vec.Vec.from_val, h']

theorem result_reads_some (r : PspResult) (out : alloc.vec.Vec h5i_app_sql.Read) (h : out.length < 4) :
    ∃ o, (do let out1 ← result_reads r out; ok (some out1)) = ok o ∧
      planOf o = some (out.val.map Read.abs ++ resultA r) := by
  obtain ⟨v, hv, hva⟩ := result_reads_abs r out h
  exact ⟨some v, by rw [hv]; simp, by simp [planOf, hva]⟩

/-- The extracted `reads` computes `readsA`. -/
theorem reads_abs (a : Principal) (c : Command) : ∃ o, reads a c = ok o ∧ planOf o = readsA a c := by
  cases c
  case Record p r =>
    simp only [reads, v_int_eq, p_eq, rd_where, h5i_app_sql.whole, bind_ok]
    simp only [alloc.vec.Vec.push, alloc.vec.Vec.new, List.length_nil, U32.max, U32.numBits]
    rw [dif_pos (by simp)]; simp only [bind_ok]
    refine Exists.elim (result_reads_some r _ ?_) (fun o h => ⟨o, h.1, h.2.trans ?_⟩)
    · simp [alloc.vec.Vec.length]
    · simp [readsA, Read.abs, Pred.abs, Window.abs, eqU, T_PAYMENTS, PAYMENT_ID]
  case Event e p r =>
    simp only [reads, v_int_eq, p_eq, rd_where, h5i_app_sql.whole, bind_ok]
    simp only [alloc.vec.Vec.push, alloc.vec.Vec.new, List.length_nil, U32.max, U32.numBits]
    rw [dif_pos (by simp)]; simp only [bind_ok]
    simp only [alloc.vec.Vec.from_val, List.nil_append, List.length_singleton]
    rw [dif_pos (by simp)]; simp only [bind_ok]
    refine Exists.elim (result_reads_some r _ ?_) (fun o h => ⟨o, h.1, h.2.trans ?_⟩)
    · simp [alloc.vec.Vec.length]
    · simp [readsA, Read.abs, Pred.abs, Window.abs, eqU, T_PAYMENTS, PAYMENT_ID, T_EVENTS, EVENT_ID]
  case List =>
    cases ha : a.operator <;>
      simp [reads, readsA, ha, rd_where, p_eq, h5i_app_sql.whole, planOf, Read.abs, Pred.abs, Window.abs, eqU,
        alloc.vec.Vec.push, alloc.vec.Vec.new, T_PAYMENTS, PAYMENT_MERCHANT, U32.max, U32.numBits,
        alloc.vec.Vec.from_val]
  all_goals simp [reads, readsA, rd_where, p_eq, h5i_app_sql.whole, planOf, Read.abs, Pred.abs,
    Window.abs, eqU, alloc.vec.Vec.push, alloc.vec.Vec.new, T_PAYMENTS, T_REFUNDS, T_REFS, T_COUNTER,
    PAYMENT_ID, REFUND_ID, REFUND_PAYMENT, REF_PAYMENT, U32.max, U32.numBits, alloc.vec.Vec.from_val]

end payment_domain.Plan
