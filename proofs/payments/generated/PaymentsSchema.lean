  · intro o j hj ho; have := v.len_ineq; unfold Event.del_loop.body; h5i_step

/-- The rows whose column `col` does not hold `val`. -/
@[step] theorem Event.del_where_spec (v : alloc.vec.Vec Event) (col : U32) (val : Val) :
