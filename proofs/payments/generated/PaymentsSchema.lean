theorem Payment.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Payment)
    (h : rows.val.map (·.val) = l.map Payment.row) :
    Payment.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Payment.from_rows_loop rows (alloc.vec.Vec.new Payment) true 0#usize =
      loop (fun x => rowsBody Payment.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Payment, true, 0#usize) := by
    unfold Payment.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Payment.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Payment.from_rows_loop rows (alloc.vec.Vec.new Payment) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Payment.from_row Payment.row (fun x v hv => Payment.from_row_spec x v hv) rows l h
  unfold Payment.from_rows
  step with hl
  simp [ok1_post, l_post]

theorem Refund.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Refund)
    (h : rows.val.map (·.val) = l.map Refund.row) :
    Refund.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Refund.from_rows_loop rows (alloc.vec.Vec.new Refund) true 0#usize =
      loop (fun x => rowsBody Refund.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Refund, true, 0#usize) := by
    unfold Refund.from_rows_loop; congr 1; funext ⟨a, b, c⟩
    simp only []; unfold Refund.from_rows_loop.body rowsBody
    dsimp only
    split <;> (try rfl)
    congr 1; funext v; congr 1; funext o; cases o <;> rfl
  have hl : Refund.from_rows_loop rows (alloc.vec.Vec.new Refund) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop Refund.from_row Refund.row (fun x v hv => Refund.from_row_spec x v hv) rows l h
  unfold Refund.from_rows
  step with hl
  simp [ok1_post, l_post]

theorem Event.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List Event)
    (h : rows.val.map (·.val) = l.map Event.row) :
    Event.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : Event.from_rows_loop rows (alloc.vec.Vec.new Event) true 0#usize =
      loop (fun x => rowsBody Event.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new Event, true, 0#usize) := by
    unfold Event.from_rows_loop; congr 1; funext ⟨a, b, c⟩
