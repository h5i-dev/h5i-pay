theorem PspRef.from_rows_spec (rows : alloc.vec.Vec (alloc.vec.Vec Val)) (l : List PspRef)
    (h : rows.val.map (·.val) = l.map PspRef.row) :
    PspRef.from_rows rows ⦃ o => ∃ v, o = some v ∧ v.val = l ⦄ := by
  have e : PspRef.from_rows_loop rows (alloc.vec.Vec.new PspRef) true 0#usize =
      loop (fun x => rowsBody PspRef.from_row rows x.1 x.2.1 x.2.2) (alloc.vec.Vec.new PspRef, true, 0#usize) := by
    unfold PspRef.from_rows_loop; congr 1; funext ⟨a, b, c⟩
