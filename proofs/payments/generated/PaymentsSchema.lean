  have hl : PspRef.from_rows_loop rows (alloc.vec.Vec.new PspRef) true 0#usize ⦃ r => r.2 = true ∧ r.1.val = l ⦄ := by
    rw [e]; exact rows_loop PspRef.from_row PspRef.row (fun x v hv => PspRef.from_row_spec x v hv) rows l h
  unfold PspRef.from_rows
