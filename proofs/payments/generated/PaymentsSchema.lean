/-! ## Decoding -/

/-- Steps through a generated `from_row`. -/
macro "row_tac" : tactic => `(tactic| (
  repeat (first
    | (step*; done)
    | (simp_all only [Payment.row, Refund.row, Event.row, PspRef.row, Counter.row, List.getElem_cons_zero, List.getElem_cons_succ, Nat.zero_add, Nat.reduceAdd, bind_tc_ok, u64_from_val, bool_from_val, bytes_from_val]; step*))
  all_goals simp_all))

theorem Payment.from_row_spec (x : Payment) (v : alloc.vec.Vec Val) (h : v.val = Payment.row x) :
    Payment.from_row v ⦃ o => o = some x ⦄ := by
  have hl : v.length = 11 := by simp [alloc.vec.Vec.length, h, Payment.row]
  unfold Payment.from_row; row_tac

