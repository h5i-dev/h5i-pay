  unfold Event.del_where Event.del_where_loop
  apply WP.spec_mono (loop_fold v.val (fun w : alloc.vec.Vec Event => w.val)
    (fun acc y => if decide ¬((Event.row y)[col.val]? = some val) then acc ++ [y] else acc)
    (fun w j => w.length ≤ j) (fun x => Event.del_where_loop.body v col val x.1 x.2) ?_ _ 0#usize (by simp) (by simp))
  · intro r hr; rw [hr, foldl_filter]; simp
  · intro o j hj ho; have := v.len_ineq; unfold Event.del_where_loop.body; h5i_step

