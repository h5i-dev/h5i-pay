      let v ← one (Write.PutPayment p1)
      ok (core.result.Result.Ok (v, Reply.Status CANCELED))
    else
      if p.status = AUTHORIZED
      then
        let p1 ← with_status p CANCELED p.authorized p.captured op
        let v ← one (Write.PutPayment p1)
        ok (core.result.Result.Ok (v, Reply.Status CANCELED))
      else
        if p.status = CANCELED
