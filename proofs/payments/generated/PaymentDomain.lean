  | Write.PutRef r => let v ← PspRef.put s.refs r
                      ok { s with refs := v }
  | Write.SetCounter c => ok { s with counter := c }
  | Write.PutMerchant c =>
    let v ← MerchantCounter.put s.merchants c
    ok { s with merchants := v }
  | Write.PutHistory h =>
    let v ← HistoryEntry.put s.history h
    ok { s with history := v }

