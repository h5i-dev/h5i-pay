    Source: 'crates/payment-domain/src/lib.rs', lines 462:0-495:1 -/
def create
  (actor : Principal) (s : Snapshot) (amount : Std.U64) (currency : Std.U32)
  (manual_capture : Bool) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  if amount = 0#u64
  then ok (core.result.Result.Err Error.InvalidAmount)
  else
    if s.counter.next_id = core.num.U64.MAX
    then ok (core.result.Result.Err Error.Overflow)
    else
      let merchant ← user_of actor
      let n ← merchant_next s.merchants merchant
      if n = core.num.U64.MAX
      then ok (core.result.Result.Err Error.Overflow)
      else
        let i ← operator_of actor
        let i1 ← s.counter.next_id + 1#u64
        let i2 ← n + 1#u64
        let v ←
          three (Write.PutPayment
            {
              id := s.counter.next_id,
              merchant,
              amount,
              currency,
              status := CREATED,
              manual_capture,
              attempts := 0#u64,
              authorized := 0#u64,
              captured := 0#u64,
              refunded := 0#u64,
              refund_pending := 0#u64,
              operator := i,
              ledger_done := false,
              seq := n,
              changes := 0#u64
            }) (Write.SetCounter { next_id := i1 }) (Write.PutMerchant
            { merchant, next := i2 })
        ok (core.result.Result.Ok (v, Reply.Created s.counter.next_id))

/-- [payment_domain::begin_authorize]:
    Source: 'crates/payment-domain/src/lib.rs', lines 497:0-529:1 -/
def begin_authorize
  (actor : Principal) (s : Snapshot) (id : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_payment s.payments id
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some p =>
    let b ← may_manage actor p
    if b
    then
      if p.status != CREATED
      then ok (core.result.Result.Err Error.InvalidTransition)
      else
        if p.attempts = core.num.U64.MAX
        then ok (core.result.Result.Err Error.Overflow)
        else
          let i ← p.attempts + 1#u64
          let i1 ← operator_of actor
          let v ←
            one (Write.PutPayment
              {
                p
                  with
                  status := PROCESSING,
                  attempts := i,
                  operator := i1,
                  ledger_done := false
              })
          ok (core.result.Result.Ok (v, Reply.Payment
            {
              p
                with
                status := PROCESSING,
                attempts := i,
                operator := i1,
                ledger_done := false
            }))
    else ok (core.result.Result.Err Error.NotFound)

