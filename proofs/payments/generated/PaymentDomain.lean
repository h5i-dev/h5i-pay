def decode (r : Rows) : Result (Option Snapshot) := do
  let o ← Counter.from_one r.counter
  match o with
  | none => ok none
  | some x =>
    let o1 ← Payment.from_rows r.payments
    match o1 with
    | none => ok none
    | some x1 =>
      let o2 ← Refund.from_rows r.refunds
      match o2 with
      | none => ok none
      | some x2 =>
        let o3 ← Event.from_rows r.events
        match o3 with
        | none => ok none
        | some x3 =>
          let o4 ← PspRef.from_rows r.refs
          match o4 with
          | none => ok none
          | some x4 =>
            let o5 ← MerchantCounter.from_rows r.merchants
            match o5 with
            | none => ok none
            | some x5 =>
              ok (some
                {
                  counter := x,
                  payments := x1,
                  refunds := x2,
                  events := x3,
                  refs := x4,
                  merchants := x5
                })

