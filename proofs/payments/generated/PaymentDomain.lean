            let p2 ← with_refunds p p.refunded i
            let v ←
              two (Write.PutRefund { r with status := REFUND_FAILED })
                (Write.PutPayment p2)
            ok (core.result.Result.Ok (v, Reply.Status p.status))
      else
        if succeeded
        then
          if r.status = REFUND_SUCCEEDED
