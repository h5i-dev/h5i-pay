def record_refund
  (s : Snapshot) (p : Payment) (refund : Std.U64) (succeeded : Bool)
  (op : Std.U64) :
  Result (core.result.Result ((alloc.vec.Vec Write) × Reply) Error)
  := do
  let o ← find_refund s.refunds refund
  match o with
  | none => ok (core.result.Result.Err Error.NotFound)
  | some r =>
    if r.payment != p.id
    then ok (core.result.Result.Err Error.NotFound)
    else
      if r.status = REFUND_PENDING
      then
        if r.amount > p.refund_pending
        then ok (core.result.Result.Err Error.Corrupt)
        else
