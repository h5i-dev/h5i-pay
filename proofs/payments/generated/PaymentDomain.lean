def result_reads
  (result : PspResult) (out : alloc.vec.Vec h5i_app_sql.Read) :
  Result (alloc.vec.Vec h5i_app_sql.Read)
  := do
  match result with
  | PspResult.Authorized _ => ok out
  | PspResult.Declined => ok out
  | PspResult.Captured _ => ok out
  | PspResult.Canceled => ok out
  | PspResult.RefundSucceeded refund =>
    let v ← v_int refund
    let p ← p_eq REFUND_ID v
    let r ← rd_where T_REFUNDS p
    alloc.vec.Vec.push out r
  | PspResult.RefundFailed refund =>
    let v ← v_int refund
    let p ← p_eq REFUND_ID v
    let r ← rd_where T_REFUNDS p
    alloc.vec.Vec.push out r

/-- [payment_domain::reads]:
    Source: 'crates/payment-domain/src/lib.rs', lines 959:0-1029:1
    Visibility: public -/
def reads
  (actor : Principal) (cmd : Command) :
  Result (Option (alloc.vec.Vec h5i_app_sql.Read))
  := do
  match cmd with
  | Command.Create _ _ _ =>
    let r ← rd_where T_COUNTER h5i_app_sql.Pred.All
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let i ← user_of actor
    let v ← v_int i
    let p ← p_eq MERCHANT_KEY v
    let r1 ← rd_where T_MERCHANTS p
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)
  | Command.BeginAuthorize id =>
    let v ← v_int id
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    ok (some out)
  | Command.Cancel id =>
    let v ← v_int id
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    ok (some out)
  | Command.RequestRefund payment _ =>
    let v ← v_int payment
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let r1 ← rd_where T_COUNTER h5i_app_sql.Pred.All
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)
  | Command.Record payment result =>
    let v ← v_int payment
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let out1 ← result_reads result out
    ok (some out1)
  | Command.Event ev payment result =>
    let v ← v_int ev
    let p ← p_eq EVENT_ID v
    let r ← rd_where T_EVENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let v1 ← v_int payment
    let p1 ← p_eq PAYMENT_ID v1
    let r1 ← rd_where T_PAYMENTS p1
    let out1 ← alloc.vec.Vec.push out r1
    let out2 ← result_reads result out1
    ok (some out2)
  | Command.AttachRef payment _ =>
    let v ← v_int payment
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let p1 ← p_eq REF_PAYMENT v
    let r1 ← rd_where T_REFS p1
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)
  | Command.Get id =>
    let v ← v_int id
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    ok (some out)
  | Command.List merchant «from» limit =>
    if limit != 0#u32
    then
      if limit <= MAX_PAGE
      then
        let b ← is_operator actor
        if b
        then
          let «end» ← page_end «from» limit
          let out ←
            if «from» < «end»
            then
              do
              let range ← seq_range PAYMENT_SEQ «from» «end»
              let v ← v_int merchant
              let p ← p_eq PAYMENT_MERCHANT v
              let r ← rd_where T_PAYMENTS (h5i_app_sql.Pred.And p range)
              alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
            else ok (alloc.vec.Vec.new h5i_app_sql.Read)
          let v ← v_int merchant
          let p ← p_eq MERCHANT_KEY v
          let r ← rd_where T_MERCHANTS p
          let out1 ← alloc.vec.Vec.push out r
          ok (some out1)
        else
          let i ← user_of actor
          if merchant = i
          then
            let «end» ← page_end «from» limit
            let out ←
              if «from» < «end»
              then
                do
                let range ← seq_range PAYMENT_SEQ «from» «end»
                let v ← v_int merchant
                let p ← p_eq PAYMENT_MERCHANT v
                let r ← rd_where T_PAYMENTS (h5i_app_sql.Pred.And p range)
                alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
              else ok (alloc.vec.Vec.new h5i_app_sql.Read)
            let v ← v_int merchant
            let p ← p_eq MERCHANT_KEY v
            let r ← rd_where T_MERCHANTS p
            let out1 ← alloc.vec.Vec.push out r
            ok (some out1)
          else ok (some (alloc.vec.Vec.new h5i_app_sql.Read))
      else ok (some (alloc.vec.Vec.new h5i_app_sql.Read))
    else ok (some (alloc.vec.Vec.new h5i_app_sql.Read))
  | Command.GetRefund id =>
    let v ← v_int id
    let p ← p_eq REFUND_ID v
    let r ← rd_where T_REFUNDS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let p1 ← p_eq REFUND_ID v
    let w ← h5i_app_sql.whole
    let r1 ←
      rd_where T_PAYMENTS (h5i_app_sql.Pred.In PAYMENT_ID T_REFUNDS p1
        REFUND_PAYMENT w)
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)
  | Command.Refunds payment =>
    let v ← v_int payment
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let p1 ← p_eq REFUND_PAYMENT v
    let r1 ← rd_where T_REFUNDS p1
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)
  | Command.GetRef payment =>
    let v ← v_int payment
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let p1 ← p_eq REF_PAYMENT v
    let r1 ← rd_where T_REFS p1
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)
  | Command.View id =>
    let v ← v_int id
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let p1 ← p_eq REFUND_PAYMENT v
    let r1 ← rd_where T_REFUNDS p1
    let out1 ← alloc.vec.Vec.push out r1
    let p2 ← p_eq REF_PAYMENT v
    let r2 ← rd_where T_REFS p2
    let out2 ← alloc.vec.Vec.push out1 r2
    ok (some out2)
  | Command.MarkPosted payment _ _ =>
    let v ← v_int payment
    let p ← p_eq PAYMENT_ID v
    let r ← rd_where T_PAYMENTS p
    let out ← alloc.vec.Vec.push (alloc.vec.Vec.new h5i_app_sql.Read) r
    let p1 ← p_eq REFUND_PAYMENT v
    let r1 ← rd_where T_REFUNDS p1
    let out1 ← alloc.vec.Vec.push out r1
    ok (some out1)

