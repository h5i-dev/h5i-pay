/-- [payment_domain::policy::check]:
    Source: 'crates/payment-domain/src/policy.rs', lines 102:0-134:1
    Visibility: public -/
def policy.check
  (l : policy.Limits) (merchants : Slice Std.U64) (blocked : Slice Std.U64)
  (n_blocked : Std.Usize) (r : policy.PaymentReq) :
  Result Std.U32
  := do
  let i ← lift (UScalar.cast .Usize l.n_currencies)
  if i > policy.MAX_CURRENCIES
  then ok policy.BAD_POLICY
  else
    if n_blocked > policy.MAX_BLOCKED
    then ok policy.BAD_POLICY
    else
      let i1 := Slice.len blocked
      if n_blocked > i1
      then ok policy.BAD_POLICY
      else
        if r.amount = 0#u64
        then ok policy.ZERO_AMOUNT
        else
          if r.amount < l.min_amount
          then ok policy.BELOW_MINIMUM
          else
            let i2 ← lift (UScalar.cast .Usize r.kind)
            if i2 >= policy.KINDS
            then ok policy.UNKNOWN_KIND
            else
              let i3 ← l.kinds_mask >>> r.kind
              let i4 ← lift (i3 &&& 1#u32)
              if i4 = 0#u32
              then ok policy.KIND_NOT_ALLOWED
              else
                let i5 ← lift (UScalar.cast .Usize r.kind)
                let i6 ← Array.index_usize l.max_amount i5
                if r.amount > i6
                then ok policy.ABOVE_LIMIT
                else
                  let b ← policy.currency_allowed l r.currency
                  if b
                  then
                    let b1 ← policy.contains_sorted merchants r.merchant
                    if b1
                    then
                      if r.recipient = r.merchant
                      then ok policy.SELF_PAYMENT
                      else
                        let b2 ←
                          policy.contains_linear blocked n_blocked r.recipient
                        if b2
                        then ok policy.RECIPIENT_BLOCKED
                        else ok policy.APPROVED
                    else ok policy.MERCHANT_NOT_ALLOWED
                  else ok policy.CURRENCY_NOT_ALLOWED

